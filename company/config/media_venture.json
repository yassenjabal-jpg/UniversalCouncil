  "execution_recovery": {
    "policy_version": "1.0",
    "uses_hybrid_execution_journal": true,
    "checkpoint_required_before_application_handoff": true,
    "checkpoint_required_after_verified_state_change": true,
    "unknown_is_never_success": true,
    "replay_unknown_default": false,
    "same_route_retry_limit": 1,
    "required_checkpoint_fields": [
      "episode_id",
      "stage_id",
      "action_id",
      "application",
      "application_version",
      "project_path",
      "artifact_or_project_version",
      "expected_postcondition",
      "last_verified_state",
      "next_safe_action"
    ],
    "application_handoff_states": [
      "PLANNED",
      "APPLICATION_READY",
      "PROJECT_OPENED",
      "ACTION_DISPATCHED",
      "POSTCONDITION_VERIFIED",
      "CHECKPOINT_SAVED",
      "FAILED",
      "UNKNOWN"
    ],
    "recovery_sequence": [
      "observe_current_application_state",
      "reconcile_journal_and_project_checkpoint",
      "resume_from_last_verified_checkpoint",
      "retry_same_route_once_if_idempotent_or_reversible",
      "use_authorized_fallback_tool_or_route",
      "hold_and_escalate_when_state_remains_unknown"
    ],
    "no_progress_policy": {
      "detect_no_progress": true,
      "require_bounded_timeout": true,
      "capture_diagnostic_state": true,
      "do_not_repeat_blind_clicks": true
    },
    "fallback_constraints": [
      "fallback_must_preserve_task_intent",
      "fallback_must_be_authorized",
      "fallback_must_not_silently_reduce_quality_gate",
      "fallback_must_not_destroy_or_overwrite_unverified_work"
    ]
  },
