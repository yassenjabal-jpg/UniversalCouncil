        "ai_visual_generation",
        "b_roll",
        "visual_continuity",
        "editing",
        "sound",
        "subtitles",
        "technical_export"
      ]
    },
    {
      "id": "audience_growth_packaging",
      "name": "Audience Growth & Packaging Operator",
      "default_status": "ON_DEMAND",
