  "operating_model": {
    "mode": "SMALL_CORE_ROUTED_CRAFT_CAPABILITIES",
    "principle": "functions_are_capabilities_not_permanent_agent_processes",
    "core_functions": [
      "media_producer",
      "editorial_director"
    ],
    "mandatory_clearance_functions": [
      "independent_fact_checker"
    ],
    "routed_craft_functions": [
      "script_voice_director",
      "visual_art_director",
      "cinematography_shot_designer",
      "motion_picture_editor",
      "music_sound_supervisor",
      "dialogue_mix_engineer",
      "audience_growth_strategist",
      "thumbnail_packaging_designer"
    ],
    "on_demand_functions": [
      "localization_producer"
    ],
    "routing_rule": "invoke a function only when the current stage contract requires its craft judgment, execution, blocker, or clearance",
    "default_output_contract": [
      "decision_or_artifact_delta",
      "material_blocker_if_any",
      "next_required_handoff"
    ],
    "forbidden_defaults": [
      "every_function_reviews_every_stage",
      "mandatory_long_form_reports",
      "one_independent_agent_process_per_function",
      "repeating_context already present in shared production state"
    ],
    "parallelize_when_safe": true,
    "single_synthesis_per_gate": true,
    "owner_interrupt_only_when": [
      "material_brand_or_story_direction_conflict",
      "owner_voice_or_performance_approval",
      "credentials_subscription_or_spend_required",
      "destructive_or_irreversible_action",
      "public_publish_approval"
    ]
  },
  "execution_recovery": {
    "policy_version": "1.0",
    "uses_hybrid_execution_journal": true,
    "checkpoint_required_before_application_handoff": true,
    "checkpoint_required_after_verified_state_change": true,
    "unknown_is_never_success": true,
    "replay_unknown_default": false,
    "same_route_retry_limit": 1,
    "required_checkpoint_fields": [
      "episode_id",
      "stage_id",
      "action_id",
      "application",
      "application_version",
      "project_path",
      "artifact_or_project_version",
      "expected_postcondition",
      "last_verified_state",
      "next_safe_action"
    ],
    "application_handoff_states": [
      "PLANNED",
      "APPLICATION_READY",
      "PROJECT_OPENED",
      "ACTION_DISPATCHED",
      "POSTCONDITION_VERIFIED",
      "CHECKPOINT_SAVED",
      "FAILED",
      "UNKNOWN"
    ],
    "recovery_sequence": [
      "observe_current_application_state",
      "reconcile_journal_and_project_checkpoint",
      "resume_from_last_verified_checkpoint",
      "retry_same_route_once_if_idempotent_or_reversible",
      "use_authorized_fallback_tool_or_route",
      "hold_and_escalate_when_state_remains_unknown"
    ],
    "no_progress_policy": {
      "detect_no_progress": true,
      "require_bounded_timeout": true,
      "capture_diagnostic_state": true,
      "do_not_repeat_blind_clicks": true
    },
    "fallback_constraints": [
      "fallback_must_preserve_task_intent",
      "fallback_must_be_authorized",
      "fallback_must_not_silently_reduce_quality_gate",
      "fallback_must_not_destroy_or_overwrite_unverified_work"
    ]
  }
}
