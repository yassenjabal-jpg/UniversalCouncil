      "proactive_capability_scouting",
      "technology_and_capability_scout_function",
      "tool_candidate_pipeline",
      "environment_benchmarking",
      "capability_kpis",
      "protected_dissent",
      "local_market_research_capability",
      "media_workforce_capability",
      "media_toolchain_capability"
