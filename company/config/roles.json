    "recommendations": [
      "KEEP",
      "IMPROVEMENT_TRIAL",
      "MERGE",
      "REMOVE_WITHOUT_REPLACEMENT",
      "REPLACE",
      "FIRE_RECOMMENDATION"
    ],
    "may_fire_unilaterally": false,
    "may_run_read_only_capability_discovery": true,
    "may_install_tools_unilaterally": false,
    "may_connect_credentials_unilaterally": false,
    "may_authenticate_accounts_unilaterally": false,
    "may_purchase_tools_unilaterally": false,
    "may_change_permissions_unilaterally": false,
    "may_enable_browser_extensions_unilaterally": false,
    "may_execute_external_writes_unilaterally": false,
    "final_authority": "Owner",
    "self_evaluation_forbidden": true,
    "complaints_about_hr_route_directly_to": "Owner",
    "performance_criteria": [
      "unique_contribution",
      "decision_impact",
      "evidence_quality",
      "conviction",
      "error_detection",
      "execution_value",
      "speed",
      "duplication",
      "tool_skill_utilization",
      "operating_cost",
      "capability_gap_detection_latency",
      "scouting_coverage",
      "candidate_decision_quality",
      "realized_capability_improvement",
      "tooling_security_regressions",
      "tool_churn_and_bureaucracy"
    ],
    "capability_request_states": [
      "AVAILABLE",
      "CAN_BUILD",
      "CAN_CONNECT",
      "HUMAN_REQUIRED",
      "NOT_FEASIBLE"
    ],
    "capability_scouting_policy": "company/config/capability_scouting.json",
    "unresolved_capability_escalation": "Owner",
    "protected_dissent": true
  },
  "naming_rule": "Never use ambiguous CRO. Use Commercial/Revenue Function and Risk/Assurance Function explicitly.",
