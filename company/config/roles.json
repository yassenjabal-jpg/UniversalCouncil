{
  "version": "1.3",
  "functions": [
    "Owner",
    "Board",
    "Venture Operator",
    "Commercial Operator",
    "Product & Delivery Operator",
    "Finance Controller",
    "Assurance Reviewer",
    "Technical Operator",
