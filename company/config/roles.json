      "name": "RevenueSystem Chief Operator Experience & UX Authority v2",
      "status": "ACTIVE_PRIMARY_DESIGN_AUTHORITY_V2",
      "owns": [
        "task_hierarchy",
        "workflow_simplification",
        "operator_workflow_forensics",
        "keyboard_first_flow",
        "keyboard_ergonomics_map",
        "information_architecture",
