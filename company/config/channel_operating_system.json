  "script_schema": {
    "required_columns": [
      "timecode",
      "narration",
      "intent",
      "emotion_tag",
      "energy_1_5",
      "pace",
      "pitch_contour",
      "emphasis_words",
      "pause_before_ms",
      "pause_after_ms",
      "breath_note",
      "pronunciation",
      "visual_beat_id",
      "music_state",
      "sfx",
      "evidence_ids",
      "translation_note",
      "shot_design_id",
      "camera_intent"
    ],
    "allowed_emotion_tags": [
      "فضول هادئ",
      "سؤال حقيقي",
      "سر صغير",
      "دهشة مضبوطة",
      "ابتسامة خفيفة",
      "جدية",
      "تأمل",
      "تأكيد",
      "تحذير هادئ",
      "همس خفيف",
      "تسارع",
      "خاتمة مفتوحة"
    ],
    "voice_rules": {
      "default": "warm conversational Iraqi + MSA",
      "avoid": [
        "news-anchor delivery",
        "constant hype",
        "synthetic overacting",
        "same cadence every sentence"
      ],
      "pause_logic": "semantic, not mechanical",
      "emphasis_limit": "maximum 1–2 emphasized words per sentence unless dramatically justified"
    }
  },
  "frame_bible": {
    "canonical_frame_types": [
      "F01 Hero Question",
      "F02 Evidence Document",
      "F03 Editorial Portrait",
      "F04 Scientific Engraving",
      "F05 Mechanism Diagram",
      "F06 Number/Scale Reveal",
      "F07 Map/Spatial",
      "F08 Object Macro",
      "F09 Historical Collage",
      "F10 Modern Reality",
      "F11 Breathing Reset",
      "F12 Ending Reflection"
    ],
    "composition_rules": {
      "negative_space_percent": "35-55",
      "dominant_hero_objects": 1,
      "max_primary_text_blocks": 1,
      "max_micro_captions": 1,
      "editable_language_layers": true
    }
  },
  "transition_system": {
    "rule": "transition must be motivated by shape, object, camera direction, semantic link, time shift, or cause/effect",
    "canonical": [
      "object wipe",
      "mask reveal",
      "shape match cut",
      "color match cut",
      "illustration-to-photo morph",
      "photo-to-diagram extraction",
      "zoom through object",
      "editorial page shift",
      "line-drawing build",
      "parallax drift",
      "foreground occlusion",
      "cobalt reset frame"
    ],
    "forbidden_default": [
      "random preset wipes",
      "constant whip-pan",
      "glitch for no narrative reason",
      "hard cut chains with no rhythm"
    ]
  },
  "anti_slop_gate": {
    "required": true,
    "checks": [
      "episode has unique thesis and question",
      "visual grammar consistent but shot substance not interchangeable",
      "no repeated AI template sequence",
      "no filler AI B-roll",
      "every shot has EVIDENCE/EXPLANATION/ATMOSPHERE/TRANSITION purpose",
      "atmosphere does not dominate runtime",
      "primary claims source-linked",
      "human narrator identity preserved",
      "visual assets pass continuity palette/type/grid check",
      "at least three episode-specific visual motifs",
      "transition map has narrative motivation"
    ],
    "fail_action": "RETURN_TO_EDITORIAL_OR_VISUAL_TREATMENT"
  },
  "quality_gates": [
    "G0 Trend/Topic Gate",
    "G1 Evidence Gate",
    "G2 Visual Story Case Gate",
    "G3 Packaging Hypothesis Gate",
    "G4 Pre-production Craft Review",
    "G5 Script + Independent Fact Check Lock",
