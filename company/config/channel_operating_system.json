      "timecode",
      "narrative_function",
      "visual_event",
      "voice_state",
      "music_state",
      "sfx_event",
      "sync_anchor",
      "prelap_postlap",
      "dynamic_intent",
      "transition_link"
    ],
    "mix_targets_internal_not_platform_requirements": {
      "program_integrated_lufs_target": "-14 LUFS ±1",
      "true_peak_ceiling": "-1 dBTP",
      "dialogue_priority": "always intelligible; music automated around speech rather than static gain",
      "music_under_dense_dialogue_guideline": "typically 12–18 dB perceptually below narration, adjusted by arrangement",
      "loudness_range_guideline": "approximately 6–10 LU for documentary dynamics",
      "intentional_sync_hit_tolerance": "±1 frame",
      "action_sfx_sync_tolerance": "±1–2 frames unless deliberate prelap/postlap",
      "localized_mix_match": "within ±1 LU perceived loudness of Arabic master where practical"
    },
    "mandatory_stems": [
      "DX dialogue",
      "MX music",
      "FX sound design",
      "AMB atmosphere",
      "FULL master"
    ],
    "monitoring_checks": [
      "studio/headphones",
      "ordinary earbuds",
      "phone speaker",
      "mono compatibility",
      "low-volume intelligibility"
    ],
    "anti_patterns": [
      "wall-to-wall music with no breathing space",
      "generic cinematic riser every reveal",
      "swoosh on every transition",
      "sidechain pumping audible as an effect",
      "SFX louder than key narration without narrative reason",
      "music chosen after final cut with no spotting",
      "same music bed across unrelated episodes"
    ]
  },
  "benchmark_profile": {
    "name": "professional_youtube_studio_benchmark_2026_10_13",
    "artifact": "docs/research/YOUTUBE_STUDIO_BENCHMARK_ARENA_2026-10-13.md",
    "reference_models": [
