    "mix_targets_internal_not_platform_requirements": {
      "program_integrated_lufs_target": "-14 LUFS ±1",
      "true_peak_ceiling": "-1 dBTP",
      "dialogue_priority": "always intelligible; music automated around speech rather than static gain",
      "music_under_dense_dialogue_guideline": "typically 12–18 dB perceptually below narration, adjusted by arrangement",
      "loudness_range_guideline": "approximately 6–10 LU for documentary dynamics",
      "intentional_sync_hit_tolerance": "±1 frame",
      "action_sfx_sync_tolerance": "±1–2 frames unless deliberate prelap/postlap",
      "localized_mix_match": "within ±1 LU perceived loudness of Arabic master where practical"
