      "test_plan",
      "mobile_legibility_check"
    ],
    "thumbnail_designer_independent_craft_function": true
  },
  "shot_design_system": {
    "required": true,
    "must_precede_animatic": true,
    "accountable_function": "Cinematography / Shot Design",
    "consultation_required": [
      "Editorial Director / Showrunner",
      "Visual Art Director / Frame Curator",
      "Motion & Picture Editor",
      "Music Supervisor & Sound Designer"
    ],
    "required_fields": [
      "shot_id",
      "story_beat_id",
      "shot_purpose",
      "framing",
      "shot_size",
      "camera_motion",
      "depth_layers",
      "subject_staging",
      "screen_direction",
      "continuity_link",
      "transition_motivation",
      "sound_sync_note",
      "asset_requirements"
    ],
    "rules": [
      "every_camera_move_requires_narrative_or_attention_purpose",
      "shot_scale_changes_must_support_story_or_emotion",
      "screen_direction_and_subject_position_must_be_checked_across_cuts",
      "depth_and_parallax_are_used_only_when_they_improve_readability_or_emphasis",
      "transition_motion_must_be_motivated_by_adjacent_shots",
      "no_generation_or_motion_shot_exists_only_to_fill_visual_space"
