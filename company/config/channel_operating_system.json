  "master_pipeline": {
    "version": "1.0",
    "name": "WRITING_PREPRODUCTION_PRODUCTION",
    "phases": [
      "writing",
      "pre_production",
      "production"
    ],
    "phase_order_locked": true,
    "phase_transition_rules": [
      "writing_cannot_complete_without_owner_title_lock_and_script_lock",
      "pre_production_cannot_start_before_script_lock",
      "production_cannot_start_before_production_ready_lock",
      "feedback_returns_to_source_phase_or_department_with_formal_return_ticket",
      "locked_title_cannot_change_without_owner_reapproval"
    ]
  },
  "writing_phase": {
    "version": "1.1",
    "name": "Writing",
    "purpose": "select one title from three market-grounded topics with two title variants each, then write and lock the script",
    "sections": [
      {
        "id": "W1_title_development",
        "name": "Market & Title Development",
        "accountable": "Audience Growth & Packaging Strategist",
        "stages": [
          {
            "id": "market_scan",
            "program": "vidIQ",
            "output": "youtube_market_signal_pack"
          },
          {
            "id": "social_trend_scan",
            "program": "Brave Browser",
            "output": "cross_platform_trend_pack"
          },
          {
            "id": "market_synthesis",
            "program": "ChatGPT",
            "output": "market_opportunity_map"
          },
          {
            "id": "story_feasibility_check",
            "program": "ChatGPT",
            "output": "story_feasibility_clearance"
          },
          {
            "id": "title_candidate_generation",
            "program": "ChatGPT",
            "output": "three_topic_cards_two_titles_each"
          },
          {
            "id": "owner_title_gate",
            "program": "ChatGPT",
            "output": "owner_title_lock"
          }
        ]
      },
      {
        "id": "W2_script_development",
        "name": "Script Development",
        "accountable": "Editorial Director / Showrunner",
        "entry_requirement": "OWNER_TITLE_LOCK",
        "stages": [
          {
            "id": "story_question",
            "program": "ChatGPT",
            "output": "title_promise_story_question"
          },
          {
            "id": "script_research_pack",
            "program": "Brave Browser",
            "output": "script_research_pack"
          },
          {
            "id": "story_architecture",
            "program": "ChatGPT",
            "output": "story_architecture"
          },
          {
            "id": "first_script",
            "program": "ChatGPT",
            "output": "first_full_script"
          },
          {
            "id": "editorial_rewrite",
            "program": "ChatGPT",
            "output": "editorial_script"
          },
          {
            "id": "independent_fact_check",
            "program": "Brave Browser",
            "output": "fact_check_clearance"
          },
          {
            "id": "narration_rewrite",
            "program": "ChatGPT",
            "output": "voice_ready_script"
          },
          {
            "id": "script_lock",
            "program": "ChatGPT",
            "output": "locked_script"
          }
        ]
      }
    ],
    "title_system": {
      "required_topic_count": 3,
      "required_titles_per_topic": 2,
      "owner_selection_required": true,
      "owner_is_only_final_title_authority": true,
      "script_start_before_owner_selection_forbidden": true,
      "topic_distinctness_required": true,
      "title_distinctness_within_topic_required": true,
      "topic_required_fields": [
        "topic",
        "why_now",
        "market_signal",
        "story_angle",
        "competition_level",
        "visual_potential",
        "evidence_feasibility",
        "eight_minute_story_feasibility",
        "risk_notes"
      ],
      "title_variant_required_fields": [
        "title",
        "click_reason",
        "viewer_promise"
      ],
      "feasibility_checks": [
        "sufficient_research_material",
        "credible_sources_available",
        "supports_at_least_eight_minutes_without_filler",
        "strong_visual_potential",
        "meaningful_payoff_or_insight",
        "title_promise_can_be_fulfilled",
        "competition_opportunity_is_acceptable",
        "no_known_unmanageable_rights_or_asset_blocker"
      ],
      "reject_if": [
        "trend_only_without_durable_story",
        "clickbait_promise_cannot_be_fulfilled",
        "insufficient_evidence",
        "insufficient_visual_story",
        "requires_filler_to_reach_target_length"
      ],
      "post_lock_revision": {
        "automatic_change_forbidden": true,
        "proposal_allowed": true,
        "required_fields": [
          "current_title",
          "proposed_title",
          "reason",
          "evidence",
          "impact_on_script_or_packaging"
        ],
        "owner_reapproval_required": true
      }
    },
    "exit_gate": "SCRIPT_LOCK"
  },
