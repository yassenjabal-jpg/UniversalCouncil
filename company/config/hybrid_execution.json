{
  "version": "0.2",
  "status": "GUI_PRIMARY_PROTOTYPE",
  "execution_order": [
    "gui_semantic_uia",
    "gui_visual_assist",
    "dc_control_plane",
    "native_api_or_connector",
    "reusable_routine"
  ],
  "dc_control_plane": {
    "authority_read": "remote_shell.read",
    "authority_execute": "remote_shell.execute",
    "dispatch_mode": "HOST_ADAPTER_REQUIRED",
    "role": "SECONDARY_SUPPORT_PLANE",
    "allowed_primary_domains": [
      "filesystem",
      "git",
      "processes",
      "tests",
      "logs",
      "artifact_checks",
      "recovery"
    ],
    "authority_target": "YASSIN"
  },
  "gui_interaction_plane": {
    "authority_observe": "desktop_computer_use.observe",
    "authority_control": "desktop_computer_use.control",
    "root_env": "COUNCIL_VIDEO_STUDIO_ROOT",
    "root_hint": "C:\\Users\\alnaseem\\Desktop\\CouncilVideoStudio",
    "verified_action_relative": "bridge/yassin_control/verified_action.py",
    "control_bridge_relative": "bridge/yassin_control/control_bridge.py",
    "raw_coordinates_enabled": false,
    "role": "PRIMARY_INTERACTION_PLANE",
    "semantic_first": true,
    "visual_fallback": true,
    "pre_action_observation_required": true,
    "post_action_verification_required_for_state_change": true,
    "authority_target": "YASSIN",
    "action_timeout_seconds": 30
  },
  "shared_state": {
    "single_physical_controller": true,
    "delta_context": true,
    "max_inline_events": 12
  },
  "verification": {
    "state_change_requires_verification": true,
    "t3_owner_confirmation_required": true,
    "unknown_is_never_success": true
  },
  "batching": {
    "enabled": true,
    "max_deterministic_steps": 6,
    "stop_on_unknown": true
  },
  "result_projection": {
    "enabled": true,
    "max_items": 6,
    "max_text_chars": 320,
    "raw_output_default": false
  },
  "automation_graduation": {
    "verified_repeats_required": 3,
    "max_unknown_results": 0,
    "max_accidental_actions": 0,
    "preferred_target": "verified_gui_routine_or_app_native_macro",
    "fingerprint_fields": [
      "app_id",
      "app_version",
      "task_class",
      "action_schema",
      "risk",
      "verifier_id",
      "environment_id",
      "authority_policy_id"
    ],
    "require_distinct_run_ids": true
  },
  "primary_plane": "GUI",
  "secondary_plane": "DC",
  "routing_profiles": {
    "interactive_app": {
      "order": [
        "gui_semantic_uia",
        "gui_visual_assist",
        "dc_control_plane"
      ],
      "require_gui_request": true,
      "dc_fallback_requires_explicit_opt_in": true,
      "dc_must_not_bypass_gui_when_gui_available": true
    },
    "host_support": {
      "order": [
        "dc_control_plane",
        "native_api_or_connector",
        "reusable_routine"
      ],
      "examples": [
        "filesystem",
        "git",
        "processes",
        "tests",
        "logs",
        "artifact_checks"
      ]
    },
    "external_service": {
      "order": [
        "native_api_or_connector",
        "dc_control_plane",
        "reusable_routine"
      ]
    }
  },
  "default_task_class": "host_support"
}
