{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Memory Event",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "created_at",
    "scope",
    "level",
    "kind",
    "subject",
    "summary",
    "details",
    "supersedes",
    "confidence",
    "sensitivity",
    "tags",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^MEM-[0-9]{8}-[0-9]{6}-[a-z0-9]{6}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "string",
      "pattern": "^(global|council|project/[a-z0-9_-]+|venture/[a-z0-9_-]+)$"
    },
    "level": {
      "enum": [
        "L2_PROJECT",
        "L3_CANONICAL",
        "L4_OWNER_DIRECTIVE"
      ]
    },
    "kind": {
      "enum": [
        "decision",
        "requirement",
        "status",
        "capability",
        "preference",
        "cancellation",
        "evidence",
        "proposal",
        "policy",
        "architecture",
        "gate_lock"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "details": {
      "type": "object"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^MEM-"
      },
      "uniqueItems": true
    },
    "confidence": {
      "enum": [
        "owner_confirmed",
        "verified",
        "evidence_backed",
        "proposal",
        "verified_evidence"
      ]
    },
    "sensitivity": {
      "enum": [
        "normal",
        "private_non_sensitive"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "uniqueItems": true
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "chat",
                "council",
                "repository",
                "tool",
                "migration",
                "github_review",
                "owner_directive"
              ]
            },
            "ref": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "github_ci_and_visual_review"
            },
            "ref": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "product_commit": {
              "type": "string"
            },
            "ci_run_id": {
              "type": "integer"
            },
            "governance_commit": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
