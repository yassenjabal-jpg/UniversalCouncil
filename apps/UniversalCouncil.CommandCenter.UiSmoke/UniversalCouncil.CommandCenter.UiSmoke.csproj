<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>UniversalCouncil.CommandCenter.UiSmoke</AssemblyName>
    <RootNamespace>UniversalCouncil.CommandCenter.UiSmoke</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UniversalCouncil.CommandCenter\UniversalCouncil.CommandCenter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\state\command-center\command-center-state.json"
             Link="state\command-center-state.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\state\command-center\orchestration-catalog.json"
             Link="state\orchestration-catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
