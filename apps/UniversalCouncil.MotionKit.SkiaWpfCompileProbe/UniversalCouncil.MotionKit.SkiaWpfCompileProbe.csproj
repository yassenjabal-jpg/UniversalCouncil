    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>UniversalCouncil.MotionKit.SkiaWpfCompileProbe</AssemblyName>
    <RootNamespace>UniversalCouncil.MotionKit.SkiaWpfCompileProbe</RootNamespace>
