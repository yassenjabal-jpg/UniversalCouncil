<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>UniversalCouncil.CommandCenter.RemoteTransport</AssemblyName>
    <RootNamespace>UniversalCouncil.CommandCenter.RemoteTransport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UniversalCouncil.CommandCenter.Core\UniversalCouncil.CommandCenter.Core.csproj" />
    <ProjectReference Include="..\UniversalCouncil.CommandCenter.Application\UniversalCouncil.CommandCenter.Application.csproj" />
    <ProjectReference Include="..\UniversalCouncil.CommandCenter.Infrastructure\UniversalCouncil.CommandCenter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\state\command-center\remote-owner-gateway.json"
             Link="state\remote-owner-gateway.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\state\command-center\remote-transport.json"
             Link="state\remote-transport.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
