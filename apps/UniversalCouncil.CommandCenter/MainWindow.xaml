<Window x:Class="UniversalCouncil.CommandCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UniversalCouncil Command Center"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F8"
        FlowDirection="RightToLeft"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="ReferenceBlue" Color="#2F6BFF" />
        <SolidColorBrush x:Key="ReferenceInk" Color="#14213D" />
        <SolidColorBrush x:Key="ReferenceMuted" Color="#5F6878" />
        <SolidColorBrush x:Key="ReferenceBorder" Color="#DCE1E8" />
        <SolidColorBrush x:Key="ReferencePanel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ReferenceViolet" Color="#7857E6" />

        <Style x:Key="HotspotButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HotspotBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HotspotBorder" Property="Background" Value="#0F2F6BFF" />
                                <Setter TargetName="HotspotBorder" Property="BorderBrush" Value="#662F6BFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HotspotBorder" Property="Background" Value="#142F6BFF" />
                                <Setter TargetName="HotspotBorder" Property="BorderBrush" Value="#FF2F6BFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HotspotBorder" Property="Background" Value="#202F6BFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReasoningHotspotStyle"
               TargetType="Button"
               BasedOn="{StaticResource HotspotButtonStyle}">
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ReasoningBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ReasoningBorder" Property="Background" Value="#147857E6" />
                                <Setter TargetName="ReasoningBorder" Property="BorderBrush" Value="#997857E6" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ReasoningBorder" Property="Background" Value="#1F7857E6" />
                                <Setter TargetName="ReasoningBorder" Property="BorderBrush" Value="#FF7857E6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NativeRoleButtonStyle" TargetType="Button">
            <Setter Property="FlowDirection" Value="RightToLeft" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NativeRoleSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NativeRoleSurface" Property="Background" Value="#0A2F6BFF" />
                                <Setter TargetName="NativeRoleSurface" Property="BorderBrush" Value="#302F6BFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NativeRoleSurface" Property="Background" Value="#102F6BFF" />
                                <Setter TargetName="NativeRoleSurface" Property="BorderBrush" Value="#A02F6BFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NativeReasoningDotStyle" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#FCFFFFFF" />
            <Setter Property="BorderBrush" Value="#806B5CE7" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Ellipse Width="5"
                                     Height="5"
                                     Fill="{TemplateBinding BorderBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="#F2EEFF" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="#ECE5FF" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NativePulseActionStyle" TargetType="Button">
            <Setter Property="FlowDirection" Value="RightToLeft" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#FBFAFF" />
            <Setter Property="BorderBrush" Value="#D7C8FA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#5E46B6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DrawerActionStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource ReferenceBlue}" />
            <Setter Property="BorderBrush" Value="#CBD7EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="DrawerLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ReferenceMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="DrawerValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ReferenceInk}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="ReferenceHost"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Viewbox Stretch="Uniform"
                     StretchDirection="Both"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Grid Width="1536" Height="1024" Background="#F7F6F2">
                    <Image x:Name="ReferenceImage"
                           Source="/UniversalCouncil.CommandCenter;component/Assets/VisualReferences/01-home_owner_workspace.png"
                           Stretch="Fill"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="مرجع Home / Owner Workspace المعتمد" />

                    <Canvas x:Name="InteractionCanvas"
                            Width="1536"
                            Height="1024"
                            Background="Transparent">

                        <!-- Operational rail / composer routing -->
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="15" Canvas.Top="62"
                                Width="218" Height="156"
                                Tag="autopilot"
                                Click="Region_Click"
                                ToolTip="Autopilot — الحالة التشغيلية"
                                AutomationProperties.Name="Autopilot status" />

                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="247" Canvas.Top="164"
                                Width="124" Height="135"
                                Tag="council-route"
                                Click="Route_Click"
                                ToolTip="المجلس"
                                AutomationProperties.Name="توجيه إلى المجلس" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="373" Canvas.Top="164"
                                Width="115" Height="135"
                                Tag="studio-route"
                                Click="Route_Click"
                                ToolTip="الاستوديو"
                                AutomationProperties.Name="توجيه إلى الاستوديو" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="490" Canvas.Top="164"
                                Width="112" Height="135"
                                Tag="auto-route"
                                Click="Route_Click"
                                ToolTip="التنفيذ التلقائي"
                                AutomationProperties.Name="توجيه إلى التنفيذ التلقائي" />

                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="1275" Canvas.Top="228"
                                Width="174" Height="56"
                                Tag="start"
                                Click="Start_Click"
                                ToolTip="ابدأ التنفيذ"
                                AutomationProperties.Name="ابدأ التنفيذ" />

                        <!-- Council Pulse: exact eight member identities -->
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="319" Canvas.Top="349"
                                Width="108" Height="100"
                                Tag="owner"
                                Click="Role_Click"
                                ToolTip="المالك — تحديد الاتجاه"
                                AutomationProperties.Name="المالك — تحديد الاتجاه" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="450" Canvas.Top="349"
                                Width="108" Height="100"
                                Tag="strategy"
                                Click="Role_Click"
                                ToolTip="الاستراتيجية — تحليل وفرص"
                                AutomationProperties.Name="الاستراتيجية — تحليل وفرص" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="581" Canvas.Top="349"
                                Width="108" Height="100"
                                Tag="research"
                                Click="Role_Click"
                                ToolTip="البحث — جمع الأدلة"
                                AutomationProperties.Name="البحث — جمع الأدلة" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="710" Canvas.Top="349"
                                Width="108" Height="100"
                                Tag="verification"
                                Click="Role_Click"
                                ToolTip="التحقق — مراجعة الحقائق"
                                AutomationProperties.Name="التحقق — مراجعة الحقائق" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="839" Canvas.Top="349"
                                Width="108" Height="100"
                                Tag="execution"
                                Click="Role_Click"
                                ToolTip="التنفيذ — تحويل إلى عمل"
                                AutomationProperties.Name="التنفيذ — تحويل إلى عمل" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="968" Canvas.Top="349"
                                Width="108" Height="100"
                                Tag="creative"
                                Click="Role_Click"
                                ToolTip="الإبداع — تصميم وإنتاج"
                                AutomationProperties.Name="الإبداع — تصميم وإنتاج" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="1098" Canvas.Top="349"
                                Width="108" Height="100"
                                Tag="data"
                                Click="Role_Click"
                                ToolTip="البيانات — تحليل وقياس"
                                AutomationProperties.Name="البيانات — تحليل وقياس" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="1227" Canvas.Top="349"
                                Width="108" Height="100"
                                Tag="learning"
                                Click="Role_Click"
                                ToolTip="التعلم — تطوير مستمر"
                                AutomationProperties.Name="التعلم — تطوير مستمر" />

                        <!-- Reasoning ring targets. They deliberately remain smaller than member targets. -->
                        <Button Style="{StaticResource ReasoningHotspotStyle}"
                                Canvas.Left="381" Canvas.Top="345"
                                Width="30" Height="30"
                                Tag="owner"
                                Click="Reasoning_Click"
                                ToolTip="Model &amp; Reasoning — المالك"
                                AutomationProperties.Name="استدلال المالك" />
                        <Button Style="{StaticResource ReasoningHotspotStyle}"
                                Canvas.Left="512" Canvas.Top="345"
                                Width="30" Height="30"
                                Tag="strategy"
                                Click="Reasoning_Click"
                                ToolTip="Model &amp; Reasoning — الاستراتيجية"
                                AutomationProperties.Name="استدلال الاستراتيجية" />
                        <Button Style="{StaticResource ReasoningHotspotStyle}"
                                Canvas.Left="643" Canvas.Top="345"
                                Width="30" Height="30"
                                Tag="research"
                                Click="Reasoning_Click"
                                ToolTip="Model &amp; Reasoning — البحث"
                                AutomationProperties.Name="استدلال البحث" />
                        <Button Style="{StaticResource ReasoningHotspotStyle}"
                                Canvas.Left="772" Canvas.Top="345"
                                Width="30" Height="30"
                                Tag="verification"
                                Click="Reasoning_Click"
                                ToolTip="Model &amp; Reasoning — التحقق"
                                AutomationProperties.Name="استدلال التحقق" />
                        <Button Style="{StaticResource ReasoningHotspotStyle}"
                                Canvas.Left="901" Canvas.Top="345"
                                Width="30" Height="30"
                                Tag="execution"
                                Click="Reasoning_Click"
                                ToolTip="Model &amp; Reasoning — التنفيذ"
                                AutomationProperties.Name="استدلال التنفيذ" />
                        <Button Style="{StaticResource ReasoningHotspotStyle}"
                                Canvas.Left="1030" Canvas.Top="345"
                                Width="30" Height="30"
                                Tag="creative"
                                Click="Reasoning_Click"
                                ToolTip="Model &amp; Reasoning — الإبداع"
                                AutomationProperties.Name="استدلال الإبداع" />
                        <Button Style="{StaticResource ReasoningHotspotStyle}"
                                Canvas.Left="1160" Canvas.Top="345"
                                Width="30" Height="30"
                                Tag="data"
                                Click="Reasoning_Click"
                                ToolTip="Model &amp; Reasoning — البيانات"
                                AutomationProperties.Name="استدلال البيانات" />
                        <Button Style="{StaticResource ReasoningHotspotStyle}"
                                Canvas.Left="1289" Canvas.Top="345"
                                Width="30" Height="30"
                                Tag="learning"
                                Click="Reasoning_Click"
                                ToolTip="Model &amp; Reasoning — التعلم"
                                AutomationProperties.Name="استدلال التعلم" />

                        <!-- Active Work -->
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="246" Canvas.Top="484"
                                Width="401" Height="215"
                                Tag="smart-secretary"
                                Click="Project_Click"
                                ToolTip="فتح المشروع الأول"
                                AutomationProperties.Name="فتح مشروع Smart Secretary V2" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="654" Canvas.Top="484"
                                Width="396" Height="215"
                                Tag="privacy"
                                Click="Project_Click"
                                ToolTip="فتح المشروع الثاني"
                                AutomationProperties.Name="فتح مشروع Privacy" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="1057" Canvas.Top="484"
                                Width="395" Height="215"
                                Tag="erasure"
                                Click="Project_Click"
                                ToolTip="فتح المشروع الثالث"
                                AutomationProperties.Name="فتح مشروع Erasure Contract" />

                        <!-- Owner summary row -->
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="246" Canvas.Top="707"
                                Width="255" Height="194"
                                Tag="since-away"
                                Click="Region_Click"
                                ToolTip="منذ آخر زيارة"
                                AutomationProperties.Name="منذ آخر زيارة" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="507" Canvas.Top="707"
                                Width="502" Height="194"
                                Tag="needs-decision"
                                Click="Region_Click"
                                ToolTip="يحتاج قرارك"
                                AutomationProperties.Name="يحتاج قرارك" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="1014" Canvas.Top="707"
                                Width="439" Height="194"
                                Tag="recent-results"
                                Click="Region_Click"
                                ToolTip="النتائج الأخيرة"
                                AutomationProperties.Name="النتائج الأخيرة" />

                        <!-- Persistent chrome -->
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="9" Canvas.Top="912"
                                Width="1518" Height="100"
                                Tag="tool-dock"
                                Click="Region_Click"
                                ToolTip="Tool Dock"
                                AutomationProperties.Name="Tool Dock" />

                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="1462" Canvas.Top="61"
                                Width="69" Height="850"
                                Tag="global-nav"
                                Click="Region_Click"
                                ToolTip="التنقل العام"
                                AutomationProperties.Name="التنقل العام" />

                        <!-- Interaction emphasis: one bounded activation ring, event-driven only. -->
                        <Ellipse x:Name="RoleActivationRing"
                                 Width="118"
                                 Height="110"
                                 Visibility="Collapsed"
                                 Stroke="#B82F6BFF"
                                 StrokeThickness="3"
                                 Fill="Transparent"
                                 IsHitTestVisible="False"
                                 Opacity="0" />
                    </Canvas>

                    <!--
                        First native reconstruction slice.
                        Reference pixels remain directly underneath for fidelity comparison.
                        Ctrl+Shift+O toggles blend comparison without changing truth state.
                    -->
                    <Canvas x:Name="NativeHomeLayer"
                            Width="1536"
                            Height="1024"
                            FlowDirection="LeftToRight"
                            Background="{x:Null}"
                            Panel.ZIndex="5"
                            AutomationProperties.Name="Native Home reconstruction layer — Council Pulse">
                        <Canvas.RenderTransform>
                            <TranslateTransform Y="23" />
                        </Canvas.RenderTransform>

                        <Border Canvas.Left="244"
                                Canvas.Top="313"
                                Width="1211"
                                Height="140"
                                Background="#FFFCFBF8"
                                BorderBrush="#FFE7E2D9"
                                BorderThickness="1"
                                CornerRadius="15"
                                IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="9"
                                                  ShadowDepth="1"
                                                  Opacity="0.08"
                                                  Color="#4A5364" />
                            </Border.Effect>
                        </Border>

                        <Ellipse Canvas.Left="263"
                                 Canvas.Top="327"
                                 Width="25"
                                 Height="25"
                                 Fill="#2F6BFF"
                                 IsHitTestVisible="False" />
                        <TextBlock Canvas.Left="270"
                                   Canvas.Top="329"
                                   Text="◉"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   IsHitTestVisible="False" />
                        <TextBlock Canvas.Left="296"
                                   Canvas.Top="321"
                                   Width="112"
                                   FlowDirection="RightToLeft"
                                   Text="نبض المجلس"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#14213D"
                                   IsHitTestVisible="False" />
                        <Ellipse Canvas.Left="414"
                                 Canvas.Top="331"
                                 Width="9"
                                 Height="9"
                                 Fill="#2BC86B"
                                 IsHitTestVisible="False" />
                        <TextBlock Canvas.Left="428"
                                   Canvas.Top="323"
                                   Width="112"
                                   FlowDirection="RightToLeft"
                                   Text="يعمل بشكل طبيعي"
                                   FontSize="10"
                                   Foreground="#687384"
                                   IsHitTestVisible="False" />

                        <Button Canvas.Left="1301"
                                Canvas.Top="320"
                                Width="137"
                                Style="{StaticResource NativePulseActionStyle}"
                                Content="عرض نشاط المجلس"
                                Click="CouncilActivity_Click"
                                AutomationProperties.Name="عرض نشاط المجلس" />

                        <!-- Fine dotted routing paths; decorative only. -->
                        <Path Data="M 394,381 C 437,343 478,343 525,381 S 615,418 658,381"
                              Stroke="#8457E6"
                              StrokeThickness="1.6"
                              StrokeDashArray="1 5"
                              Opacity="0.38"
                              IsHitTestVisible="False" />
                        <Path Data="M 524,381 C 570,347 616,347 658,381 S 747,414 789,381"
                              Stroke="#56A8F6"
                              StrokeThickness="1.6"
                              StrokeDashArray="1 5"
                              Opacity="0.42"
                              IsHitTestVisible="False" />
                        <Path Data="M 789,381 C 832,414 875,414 919,381 S 1007,347 1050,381"
                              Stroke="#2DBBD5"
                              StrokeThickness="1.6"
                              StrokeDashArray="1 5"
                              Opacity="0.42"
                              IsHitTestVisible="False" />
                        <Path Data="M 1050,381 C 1094,347 1138,347 1181,381 S 1268,414 1311,381"
                              Stroke="#775EDF"
                              StrokeThickness="1.6"
                              StrokeDashArray="1 5"
                              Opacity="0.40"
                              IsHitTestVisible="False" />

                        <Button Canvas.Left="308" Canvas.Top="350"
                                Width="112" Height="88"
                                Tag="owner"
                                Style="{StaticResource NativeRoleButtonStyle}"
                                Click="NativeRole_Click"
                                AutomationProperties.Name="المالك — تحديد الاتجاه">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="45" Height="45"
                                        Background="#FFF5DF"
                                        BorderBrush="#E9A52E"
                                        BorderThickness="1.7"
                                        CornerRadius="23"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="♙"
                                               FontFamily="Segoe UI Symbol"
                                               FontSize="24"
                                               Foreground="#A96C06"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="المالك" Margin="0,3,0,0"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#6F4B06"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="تحديد الاتجاه" FontSize="9"
                                           Foreground="#737B87"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Canvas.Left="396" Canvas.Top="351"
                                Tag="owner"
                                Style="{StaticResource NativeReasoningDotStyle}"
                                Click="NativeReasoning_Click"
                                ToolTip="Model &amp; Reasoning — المالك"
                                AutomationProperties.Name="استدلال المالك" />

                        <Button Canvas.Left="443" Canvas.Top="350"
                                Width="112" Height="88"
                                Tag="strategy"
                                Style="{StaticResource NativeRoleButtonStyle}"
                                Click="NativeRole_Click"
                                AutomationProperties.Name="الاستراتيجية — تحليل وفرص">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="45" Height="45"
                                        Background="#EAF5FF"
                                        BorderBrush="#4B9FF5"
                                        BorderThickness="1.7"
                                        CornerRadius="23"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="♟"
                                               FontFamily="Segoe UI Symbol"
                                               FontSize="23"
                                               Foreground="#116FD1"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
