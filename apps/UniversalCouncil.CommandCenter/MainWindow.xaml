        <!-- Truthful non-authoritative interaction drawer layered over the canonical visual shell. -->
        <Border x:Name="ContextDrawer"
                Width="430"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="#FCFFFFFF"
                BorderBrush="{StaticResource ReferenceBorder}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed"
                Opacity="0"
                Panel.ZIndex="50"
                AutomationProperties.Name="لوحة السياق">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerTransform" X="430" />
            </Border.RenderTransform>
            <Grid Margin="22,20,22,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="DrawerEyebrow"
                                   Text="ROLE CONTEXT"
                                   FlowDirection="LeftToRight"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ReferenceViolet}"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="DrawerTitle"
                                   Text="السياق"
                                   Margin="0,5,0,0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ReferenceInk}" />
                        <TextBlock x:Name="DrawerSubtitle"
                                   Text=""
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource ReferenceMuted}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="CloseDrawerButton"
                            Width="36"
                            Height="36"
                            Margin="14,0,0,0"
                            Content="×"
                            FontSize="22"
                            Background="#F6F8FC"
                            BorderBrush="{StaticResource ReferenceBorder}"
                            BorderThickness="1"
                            Foreground="{StaticResource ReferenceInk}"
                            Cursor="Hand"
                            Click="CloseDrawer_Click"
                            AutomationProperties.Name="إغلاق لوحة السياق" />
                </Grid>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DrawerLabelStyle}" Text="لماذا يظهر / لماذا فُعّل" />
                        <TextBlock x:Name="DrawerWhy" Style="{StaticResource DrawerValueStyle}" />

                        <TextBlock Style="{StaticResource DrawerLabelStyle}" Text="المهمة الحالية" />
                        <TextBlock x:Name="DrawerTask" Style="{StaticResource DrawerValueStyle}" />

                        <TextBlock Style="{StaticResource DrawerLabelStyle}" Text="الحالة" />
                        <TextBlock x:Name="DrawerState" Style="{StaticResource DrawerValueStyle}" />

                        <TextBlock Style="{StaticResource DrawerLabelStyle}" Text="النتائج / السياق" />
                        <TextBlock x:Name="DrawerFindings" Style="{StaticResource DrawerValueStyle}" />

                        <TextBlock Style="{StaticResource DrawerLabelStyle}" Text="أقوى اعتراض" />
                        <TextBlock x:Name="DrawerDissent" Style="{StaticResource DrawerValueStyle}" />

                        <TextBlock Style="{StaticResource DrawerLabelStyle}" Text="الأدلة" />
                        <TextBlock x:Name="DrawerEvidence" Style="{StaticResource DrawerValueStyle}" />

                        <TextBlock Style="{StaticResource DrawerLabelStyle}" Text="النموذج / الاستدلال" />
                        <TextBlock x:Name="DrawerReasoning" Style="{StaticResource DrawerValueStyle}" />

                        <Border Height="1"
                                Background="{StaticResource ReferenceBorder}"
                                Margin="0,2,0,14" />

                        <Button Style="{StaticResource DrawerActionStyle}"
                                Content="اسأل عن نتيجة هذا العنصر"
                                Click="AskThis_Click" />
                        <Button Style="{StaticResource DrawerActionStyle}"
                                Content="فتح الأدلة"
                                Click="OpenEvidence_Click" />
                        <Button Style="{StaticResource DrawerActionStyle}"
                                Content="Model &amp; Reasoning Inspector"
                                Click="ReasoningInspector_Click" />
                        <Button Style="{StaticResource DrawerActionStyle}"
                                Content="مساهمات العنصر في المشروع"
                                Click="ContributionHistory_Click" />

                        <Border Margin="0,10,0,0"
                                Padding="12"
                                Background="#F5F7FB"
                                BorderBrush="{StaticResource ReferenceBorder}"
                                BorderThickness="1">
                            <TextBlock Text="هذه الطبقة تفاعلية حقيقية فوق المرجع البصري المعتمد. لا تمنح صلاحية تنفيذ حي ولا تختلق حالة تشغيل غير متوفرة."
                                       FontSize="11"
                                       Foreground="{StaticResource ReferenceMuted}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="PrototypeNotice"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="18"
                Padding="12,8"
