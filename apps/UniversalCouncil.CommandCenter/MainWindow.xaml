<Window x:Class="UniversalCouncil.CommandCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UniversalCouncil Command Center"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FlowDirection="RightToLeft">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource RailBrush}"
                BorderBrush="{StaticResource RailBorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="UNIVERSAL COUNCIL"
                               FlowDirection="LeftToRight"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="مركز القيادة"
                               Margin="0,6,0,0"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource RailTextBrush}" />
                    <TextBlock Text="Control / Governance Plane"
                               Margin="0,5,0,0"
                               FlowDirection="LeftToRight"
                               FontSize="11"
                               Foreground="{StaticResource RailMutedBrush}"
                               HorizontalAlignment="Right" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource RailButtonStyle}"
                            Background="#252E3C"
                            Foreground="{StaticResource RailTextBrush}"
                            Content="نظرة عامة" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="المجلس" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="الاستوديو" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="المشاريع" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="الموافقات" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="المالك البعيد" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="الأدلة" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="النقل الآمن — Stage 6" />
                </StackPanel>

                <Border Grid.Row="3"
                        Padding="12"
                        Background="#1E2632"
                        BorderBrush="{StaticResource RailBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="EXECUTION"
                                   FlowDirection="LeftToRight"
                                   FontSize="9"
                                   Foreground="{StaticResource RailMutedBrush}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Snapshot.ExecutionStateLabel}"
                                   Margin="0,4,0,0"
                                   FlowDirection="LeftToRight"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#E5B84E"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="38,28,38,34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
</Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="مركز المالك البعيد"
                               FontSize="31"
                               FontWeight="SemiBold" />
                    <StackPanel Margin="0,7,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <TextBlock Text="COMMAND CENTER / STAGE 5"
                                   FlowDirection="LeftToRight"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="  —  "
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Snapshot.StageLabel}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="2"
                        Padding="18,14"
                        Background="#FFF4D9"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="0,0,4,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="بوابة الثقة للأوامر جاهزة محليًا — لا يوجد اتصال هاتف أو شبكة حي"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Snapshot.PhaseGateLabel}"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ExecutionServiceLabel}"
                                   Margin="18,0,0,0"
                                   FlowDirection="LeftToRight"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.08*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="0.92*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="20"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="المجلس"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CouncilCountLabel}"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="ROLE REGISTRY"
                                               FlowDirection="LeftToRight"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding Orchestration.Council.ContractsStatus}"
                                               Margin="0,4,0,0"
                                               FlowDirection="LeftToRight"
                                               FontSize="9"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,13,0,12"
                                    Height="1"
                                    Background="{StaticResource BorderBrush}" />

                            <TextBlock Text="الأدوار الأساسية"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />

                            <ItemsControl ItemsSource="{Binding Orchestration.Council.CoreRoles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="190"
                                                Margin="0,0,10,9"
                                                Padding="10,8"
                                                Background="{StaticResource SurfaceRaisedBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding BlockerDomain}"
                                                           Margin="0,4,0,0"
                                                           FlowDirection="LeftToRight"
                                                           FontSize="9"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Margin="0,4,0,10"
                                    Height="1"
                                    Background="{StaticResource BorderBrush}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="سياسة التوجيه"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Orchestration.Council.Objective}"
                                               Margin="0,4,0,0"
                                               FlowDirection="LeftToRight"
                                               FontSize="9"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Margin="18,0,0,0">
                                    <TextBlock Text="FREE-TEXT AUTHORITY"
                                               FlowDirection="LeftToRight"
                                               FontSize="8"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="DISABLED"
                                               Margin="0,4,0,0"
                                               FlowDirection="LeftToRight"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SuccessBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="20"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="الاستوديو"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StudioDepartmentCountLabel}"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="SERIAL PRODUCTION"
                                           FlowDirection="LeftToRight"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Top" />
                            </Grid>

                            <Border Margin="0,13,0,12"
                                    Height="1"
                                    Background="{StaticResource BorderBrush}" />

                            <TextBlock Text="{Binding MacroPhasesLabel}"
                                       FlowDirection="LeftToRight"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,0,12" />

                            <ItemsControl ItemsSource="{Binding Orchestration.Studio.Departments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="190"
                                                Margin="0,0,10,8"
                                                Padding="9,7"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Id}"
                                                           Margin="0,3,0,0"
                                                           FlowDirection="LeftToRight"
                                                           FontSize="8"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Margin="0,4,0,10"
                                    Height="1"
                                    Background="{StaticResource BorderBrush}" />

                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            FlowDirection="RightToLeft">
                                    <TextBlock Text="Human Assistance"
                                               FlowDirection="LeftToRight"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Orchestration.Studio.HumanAssistanceMode}"
                                               Margin="0,3,0,0"
                                               FlowDirection="LeftToRight"
                                               FontSize="9"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            FlowDirection="RightToLeft">
                                    <TextBlock Text="RETURN TICKET"
                                               FlowDirection="LeftToRight"
                                               FontSize="8"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding ReturnTicketFieldCountLabel}"
                                               Margin="0,4,0,0"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="0.85*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="18"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Model Control"
                                           FlowDirection="LeftToRight"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <Border Grid.Column="1"
                                        Margin="20,0,0,0"
                                        Padding="8,4"
                                        Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="ROLE ≠ MODEL"
                                               FlowDirection="LeftToRight"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="اختيار النموذج"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Owner-controlled"
                                               Margin="0,4,0,0"
                                               FlowDirection="LeftToRight"
                                               FontSize="10"
                                               Foreground="{StaticResource SuccessBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Fallback"
                                               FlowDirection="LeftToRight"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ModelFallbackLabel}"
                                               Margin="0,4,0,0"
                                               FlowDirection="LeftToRight"
                                               FontSize="10"
                                               Foreground="{StaticResource WarningBrush}" />
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,13,0,11"
                                    Height="1"
                                    Background="{StaticResource BorderBrush}" />

                            <TextBlock Text="{Binding SelectionPrecedenceLabel}"
                                       FlowDirection="LeftToRight"
                                       FontSize="9"
                                       FontFamily="Consolas"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ProviderConnectionLabel}"
                                       Margin="0,9,0,0"
                                       FlowDirection="LeftToRight"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="18"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="مكتب المالك"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1"
                                           Text="READ ONLY"
                                           FlowDirection="LeftToRight"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                            <TextBlock Text="{Binding Snapshot.OwnerApprovalLabel}"
                                       Margin="0,8,0,11"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Operational.Approvals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StateLabel}"
                                                       Margin="12,0,0,0"
                                                       FlowDirection="LeftToRight"
                                                       FontSize="9"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StateLabel}" Value="APPROVED">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                                <Border Grid.Row="4"
                        Padding="20"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Remote Owner / Secure Command Gateway"
                                           FlowDirection="LeftToRight"
                                           FontSize="19"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="قبول الأمر في الطابور لا يمنح صلاحية التنفيذ"
                                           Margin="0,5,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="18,0,0,0">
                                <TextBlock Text="{Binding RemoteOwnerConnectionLabel}"
                                           FlowDirection="LeftToRight"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningBrush}"
                                           HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding RemoteOwnerTrustLabel}"
                                           Margin="0,4,0,0"
                                           FlowDirection="LeftToRight"
                                           FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="4"
                                     Margin="0,14,0,12">
                            <Border Margin="0,0,8,0"
                                    Padding="11"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="GATEWAY MODE"
                                               FlowDirection="LeftToRight"
                                               FontSize="8"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding RemoteOwnerModeLabel}"
                                               Margin="0,5,0,0"
                                               FlowDirection="LeftToRight"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Margin="8,0"
                                    Padding="11"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="IDENTITY REGISTRY"
                                               FlowDirection="LeftToRight"
                                               FontSize="8"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding RemoteOwnerRegistryLabel}"
                                               Margin="0,5,0,0"
                                               FlowDirection="LeftToRight"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <Border Margin="8,0"
                                    Padding="11"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="TRUSTED QUEUE"
                                               FlowDirection="LeftToRight"
                                               FontSize="8"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding RemoteOwnerQueueLabel}"
                                               Margin="0,5,0,0"
                                               FlowDirection="LeftToRight"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <Border Margin="8,0,0,0"
                                    Padding="11"
                                    Background="#FFF4D9"
                                    BorderBrush="{StaticResource WarningBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="TRANSPORT"
                                               FlowDirection="LeftToRight"
                                               FontSize="8"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="AUTH BACKEND: NOT CONNECTED"
                                               Margin="0,5,0,0"
                                               FlowDirection="LeftToRight"
                                               FontSize="9"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="NETWORK LISTENER: OFF"
                                               Margin="0,3,0,0"
                                               FlowDirection="LeftToRight"
                                               FontSize="9" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Height="1"
                                Background="{StaticResource BorderBrush}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Phone / ChatGPT / GitHub / Tailscale: NOT CONNECTED  →  Trust Gate  →  Replay Guard  →  Trusted Queue"
                                       FlowDirection="LeftToRight"
                                       FontSize="9"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1"
                                       Text="EXECUTION: BLOCKED_PHASE0"
                                       Margin="16,0,0,0"
                                       FlowDirection="LeftToRight"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

<Border Grid.Row="6"
                        Padding="20"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Execution Fabric"
                                           FlowDirection="LeftToRight"
                                           FontSize="19"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Phase0SummaryLabel}"
                                           Margin="0,5,0,0"
                                           FlowDirection="LeftToRight"
                                           FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="18,0,0,0">
                                <TextBlock Text="{Binding ExecutionServiceLabel}"
                                           FlowDirection="LeftToRight"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningBrush}"
                                           HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding ProviderSummaryLabel}"
                                           Margin="0,4,0,0"
                                           FlowDirection="LeftToRight"
                                           FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,13,0,11"
                                Height="1"
                                Background="{StaticResource BorderBrush}" />

                        <ItemsControl ItemsSource="{Binding ExecutionFabric.Providers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="175" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Role}"
                                                       Margin="0,3,0,0"
                                                       FlowDirection="LeftToRight"
                                                       FontSize="8"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Note}"
                                                   Margin="12,0"
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="2"
                                                Padding="8,5"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                Background="{StaticResource SurfaceRaisedBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding State}"
                                                       FlowDirection="LeftToRight"
                                                       HorizontalAlignment="Center"
                                                       FontSize="9"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Margin="0,5,0,9"
                                Height="1"
                                Background="{StaticResource BorderBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Desktop Commander محفوظ كمرجع قديم فقط؛ الهدف الدائم هو Native Host Tooling + Semantic UIA."
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1"
                                       Text="LIVE DISPATCH: DISABLED"
                                       Margin="16,0,0,0"
                                       FlowDirection="LeftToRight"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="12"
                        Padding="20"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الحالة والأدلة الموروثة"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Operational.SourceLabel}"
                                           Margin="0,4,0,0"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Operational.StageStateLabel}"
                                       FlowDirection="LeftToRight"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Operational.Evidence}"
                                      Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Category}"
                                                   FlowDirection="LeftToRight"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Reference}"
                                                       Margin="0,3,0,0"
                                                       FlowDirection="LeftToRight"
                                                       FontFamily="Consolas"
                                                       FontSize="9"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ResultLabel}"
                                                   FlowDirection="LeftToRight"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   HorizontalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="16,12"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="الاستخدام والتكلفة"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Operational.Usage.StateLabel}"
                                       Margin="0,6,0,0"
                                       FlowDirection="LeftToRight"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}" />
                            <TextBlock Text="{Binding Operational.Usage.Note}"
                                       Margin="0,5,0,0"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="16,12"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="المرحلة التالية"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Stage 6 — Authenticated Local / Tailscale Transport Pilot"
                                       Margin="0,6,0,0"
                                       FlowDirection="LeftToRight"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="LOCKED UNTIL STAGE 5 DUAL REVIEW + G0-C REAL ROUNDTRIP; EXECUTION STILL REQUIRES PHASE 0 PASS"
                                       Margin="0,6,0,0"
                                       FlowDirection="LeftToRight"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
