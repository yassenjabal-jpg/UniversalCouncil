<Window x:Class="UniversalCouncil.CommandCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UniversalCouncil Command Center"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource RailBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="UNIVERSAL COUNCIL"
                               FlowDirection="LeftToRight"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="مركز القيادة"
                               Margin="0,6,0,0"
                               FontSize="23"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Control / Governance Plane"
                               Margin="0,5,0,0"
                               FlowDirection="LeftToRight"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Right" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource RailButtonStyle}"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Content="نظرة عامة" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="المجلس" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="الاستوديو" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="المشاريع" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="الموافقات" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="الأدلة" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="القدرات والأدوات" />
                </StackPanel>

                <Border Grid.Row="3"
                        Padding="12"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="EXECUTION"
                                   FlowDirection="LeftToRight"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Snapshot.ExecutionStateLabel}"
                                   Margin="0,4,0,0"
                                   FlowDirection="LeftToRight"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="34,28,34,34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="نظرة عامة"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Snapshot.StageLabel}"
                                   Margin="0,7,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                FlowDirection="LeftToRight"
                                HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Snapshot.ProductName}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="STAGE 1 / NON-EXECUTING"
                                   Margin="0,5,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Padding="18,15"
                        Background="#2A241B"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="!"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="بوابة التنفيذ مقفولة"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Snapshot.PhaseGateLabel}"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="20"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="حالة الوحدات"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="الحالة هنا تصف الاتصال الحقيقي فقط؛ لا توجد حالات تشغيل وهمية."
                                       Margin="0,5,0,16"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" />

                            <ItemsControl ItemsSource="{Binding Snapshot.Modules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}"
                                                           Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    Padding="10,6"
                                                    Background="{StaticResource SurfaceRaisedBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateLabel}"
                                                           HorizontalAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Padding="18"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="مكتب المالك"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Snapshot.OwnerApprovalLabel}"
                                           Margin="0,8,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Padding="18"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="قانون المرحلة"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="الواجهة تقرأ الحالة فقط. لا Shell، لا AI API، لا GUI control، ولا remote command من طبقة العرض."
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="6"
                        Padding="18"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="المرحلة التالية"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Operational State + Evidence + Owner Desk"
                                       Margin="0,4,0,0"
                                       FlowDirection="LeftToRight"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="LOCKED UNTIL DUAL REVIEW"
                                   FlowDirection="LeftToRight"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
