<Window x:Class="UniversalCouncil.CommandCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UniversalCouncil Command Center"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FlowDirection="RightToLeft">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource RailBrush}"
                BorderBrush="{StaticResource RailBorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="UNIVERSAL COUNCIL"
                               FlowDirection="LeftToRight"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="مركز القيادة"
                               Margin="0,6,0,0"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource RailTextBrush}" />
                    <TextBlock Text="Control / Governance Plane"
                               Margin="0,5,0,0"
                               FlowDirection="LeftToRight"
                               FontSize="11"
                               Foreground="{StaticResource RailMutedBrush}"
                               HorizontalAlignment="Right" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource RailButtonStyle}"
                            Background="#252E3C"
                            Foreground="{StaticResource RailTextBrush}"
                            Content="نظرة عامة" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="المجلس — Stage 3" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="الاستوديو — Stage 3" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="المشاريع" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="الموافقات" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="الأدلة" />
                    <Button Style="{StaticResource RailButtonStyle}" Content="القدرات — لاحقًا" />
                </StackPanel>

                <Border Grid.Row="3"
                        Padding="12"
                        Background="#1E2632"
                        BorderBrush="{StaticResource RailBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="EXECUTION"
                                   FlowDirection="LeftToRight"
                                   FontSize="9"
                                   Foreground="{StaticResource RailMutedBrush}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Snapshot.ExecutionStateLabel}"
                                   Margin="0,4,0,0"
                                   FlowDirection="LeftToRight"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#E5B84E"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="38,28,38,34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="نظرة عامة"
                               FontSize="31"
                               FontWeight="SemiBold" />
                    <StackPanel Margin="0,7,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <TextBlock Text="COMMAND CENTER / STAGE 2"
                                   FlowDirection="LeftToRight"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="  —  "
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Snapshot.StageLabel}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="2"
                        Padding="18,14"
                        Background="#FFF4D9"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="0,0,4,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="بوابة التنفيذ مقفولة"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Snapshot.PhaseGateLabel}"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="!"
                                   Margin="18,0,0,0"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="20"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="الحالة التشغيلية"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Operational.StageStateLabel}"
                                           FlowDirection="LeftToRight"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="{Binding Operational.SourceLabel}"
                                       Margin="0,5,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <StackPanel Margin="0,12,0,16"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="BASELINE  "
                                           FlowDirection="LeftToRight"
                                           FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding Operational.BaselineRevision}"
                                           FlowDirection="LeftToRight"
                                           FontSize="10"
                                           FontFamily="Consolas"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>

                            <Border Height="1"
                                    Background="{StaticResource BorderBrush}"
                                    Margin="0,0,0,14" />

                            <TextBlock Text="حالة الوحدات"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />
                            <TextBlock Text="الحالة هنا تصف الاتصال الحقيقي فقط؛ لا توجد حالات تشغيل وهمية."
                                       Margin="0,0,0,14"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" />

                            <ItemsControl ItemsSource="{Binding Snapshot.Modules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="132" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}"
                                                           Margin="0,2,0,0"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    Padding="8,5"
                                                    Background="{StaticResource SurfaceRaisedBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateLabel}"
                                                           HorizontalAlignment="Center"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="18"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="مكتب المالك"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1"
                                           Text="READ ONLY"
                                           FlowDirection="LeftToRight"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Border Margin="0,9,0,10"
                                    Height="2"
                                    Background="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding Snapshot.OwnerApprovalLabel}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14" />

                            <ItemsControl ItemsSource="{Binding Operational.Approvals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,10"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Title}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding StateLabel}"
                                                               FlowDirection="LeftToRight"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource WarningBrush}" />
                                                </Grid>
                                                <TextBlock Text="{Binding ScopeLabel}"
                                                           Margin="0,4,0,0"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding EvidenceReference}"
                                                           Margin="0,3,0,0"
                                                           FlowDirection="LeftToRight"
                                                           FontSize="9"
                                                           FontFamily="Consolas"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="6"
                        Padding="20"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="سجل الأدلة"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Receipts حقيقية مقروءة من مصدر الحالة؛ لا توجد Evidence Bus تنفيذية بعد."
                                           Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="EVIDENCE RECEIPTS"
                                       FlowDirection="LeftToRight"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Operational.Evidence}"
                                      Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Category}"
                                                   FlowDirection="LeftToRight"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Reference}"
                                                       Margin="0,3,0,0"
                                                       FlowDirection="LeftToRight"
                                                       FontFamily="Consolas"
                                                       FontSize="9"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Padding="8,5"
                                                Background="{StaticResource SurfaceRaisedBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ResultLabel}"
                                                       HorizontalAlignment="Center"
                                                       FlowDirection="LeftToRight"
                                                       FontSize="10"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="18"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="الاستخدام والتكلفة"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Operational.Usage.StateLabel}"
                                       Margin="0,8,0,0"
                                       FlowDirection="LeftToRight"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}" />
                            <TextBlock Text="{Binding Operational.Usage.ProviderLabel}"
                                       Margin="0,5,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Operational.Usage.Note}"
                                       Margin="0,8,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="18"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Execution Manifest"
                                       FlowDirection="LeftToRight"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Operational.ExecutionManifest.StateLabel}"
                                       Margin="0,8,0,0"
                                       FlowDirection="LeftToRight"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}" />
                            <TextBlock Text="{Binding Operational.ExecutionManifest.GateLabel}"
                                       Margin="0,5,0,0"
                                       FlowDirection="LeftToRight"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding Operational.ExecutionManifest.Note}"
                                       Margin="0,8,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="10"
                        Padding="16,12"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="المرحلة التالية: Council + Studio Orchestration"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="STAGE 3 LOCKED UNTIL DUAL REVIEW"
                                   FlowDirection="LeftToRight"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
