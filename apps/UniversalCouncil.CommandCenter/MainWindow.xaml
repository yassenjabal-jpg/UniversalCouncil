<Window x:Class="UniversalCouncil.CommandCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="UniversalCouncil Command Center"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F8"
        FlowDirection="RightToLeft"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="ReferenceBlue" Color="#2F6BFF" />
        <SolidColorBrush x:Key="ReferenceInk" Color="#14213D" />
        <SolidColorBrush x:Key="ReferenceMuted" Color="#5F6878" />
        <SolidColorBrush x:Key="ReferenceBorder" Color="#DCE1E8" />
        <SolidColorBrush x:Key="ReferencePanel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ReferenceViolet" Color="#7857E6" />

        <Style x:Key="HotspotButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HotspotBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HotspotBorder" Property="Background" Value="#0F2F6BFF" />
                                <Setter TargetName="HotspotBorder" Property="BorderBrush" Value="#662F6BFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HotspotBorder" Property="Background" Value="#142F6BFF" />
                                <Setter TargetName="HotspotBorder" Property="BorderBrush" Value="#FF2F6BFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HotspotBorder" Property="Background" Value="#202F6BFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReasoningHotspotStyle"
               TargetType="Button"
               BasedOn="{StaticResource HotspotButtonStyle}">
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ReasoningBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ReasoningBorder" Property="Background" Value="#147857E6" />
                                <Setter TargetName="ReasoningBorder" Property="BorderBrush" Value="#997857E6" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ReasoningBorder" Property="Background" Value="#1F7857E6" />
                                <Setter TargetName="ReasoningBorder" Property="BorderBrush" Value="#FF7857E6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DrawerActionStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource ReferenceBlue}" />
            <Setter Property="BorderBrush" Value="#CBD7EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="DrawerLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ReferenceMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="DrawerValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ReferenceInk}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="ReferenceHost"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Viewbox Stretch="Uniform"
                     StretchDirection="Both"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Grid Width="1536" Height="1024" Background="#F7F6F2">
                    <Image Source="/UniversalCouncil.CommandCenter;component/Assets/VisualReferences/01-home_owner_workspace.png"
                           Stretch="Fill"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           automation:AutomationProperties.Name="مرجع Home / Owner Workspace المعتمد" />

                    <Canvas x:Name="InteractionCanvas"
                            Width="1536"
                            Height="1024"
                            Background="Transparent">

                        <!-- Operational rail / composer routing -->
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="15" Canvas.Top="62"
                                Width="218" Height="156"
                                Tag="autopilot"
                                Click="Region_Click"
                                ToolTip="Autopilot — الحالة التشغيلية"
                                automation:AutomationProperties.Name="Autopilot status" />

                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="247" Canvas.Top="164"
                                Width="124" Height="135"
                                Tag="council-route"
                                Click="Route_Click"
                                ToolTip="المجلس"
                                automation:AutomationProperties.Name="توجيه إلى المجلس" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="373" Canvas.Top="164"
                                Width="115" Height="135"
                                Tag="studio-route"
                                Click="Route_Click"
                                ToolTip="الاستوديو"
                                automation:AutomationProperties.Name="توجيه إلى الاستوديو" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="490" Canvas.Top="164"
                                Width="112" Height="135"
                                Tag="auto-route"
                                Click="Route_Click"
                                ToolTip="التنفيذ التلقائي"
                                automation:AutomationProperties.Name="توجيه إلى التنفيذ التلقائي" />

                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="1275" Canvas.Top="228"
                                Width="174" Height="56"
                                Tag="start"
                                Click="Start_Click"
                                ToolTip="ابدأ التنفيذ"
                                automation:AutomationProperties.Name="ابدأ التنفيذ" />

                        <!-- Council Pulse: exact eight member identities -->
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="319" Canvas.Top="349"
                                Width="108" Height="100"
                                Tag="owner"
                                Click="Role_Click"
                                ToolTip="المالك — تحديد الاتجاه"
                                automation:AutomationProperties.Name="المالك — تحديد الاتجاه" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="450" Canvas.Top="349"
                                Width="108" Height="100"
                                Tag="strategy"
                                Click="Role_Click"
                                ToolTip="الاستراتيجية — تحليل وفرص"
                                automation:AutomationProperties.Name="الاستراتيجية — تحليل وفرص" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="581" Canvas.Top="349"
                                Width="108" Height="100"
                                Tag="research"
                                Click="Role_Click"
                                ToolTip="البحث — جمع الأدلة"
                                automation:AutomationProperties.Name="البحث — جمع الأدلة" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="710" Canvas.Top="349"
                                Width="108" Height="100"
                                Tag="verification"
                                Click="Role_Click"
                                ToolTip="التحقق — مراجعة الحقائق"
                                automation:AutomationProperties.Name="التحقق — مراجعة الحقائق" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="839" Canvas.Top="349"
                                Width="108" Height="100"
                                Tag="execution"
                                Click="Role_Click"
                                ToolTip="التنفيذ — تحويل إلى عمل"
                                automation:AutomationProperties.Name="التنفيذ — تحويل إلى عمل" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="968" Canvas.Top="349"
                                Width="108" Height="100"
                                Tag="creative"
                                Click="Role_Click"
                                ToolTip="الإبداع — تصميم وإنتاج"
                                automation:AutomationProperties.Name="الإبداع — تصميم وإنتاج" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="1098" Canvas.Top="349"
                                Width="108" Height="100"
                                Tag="data"
                                Click="Role_Click"
                                ToolTip="البيانات — تحليل وقياس"
                                automation:AutomationProperties.Name="البيانات — تحليل وقياس" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="1227" Canvas.Top="349"
                                Width="108" Height="100"
                                Tag="learning"
                                Click="Role_Click"
                                ToolTip="التعلم — تطوير مستمر"
                                automation:AutomationProperties.Name="التعلم — تطوير مستمر" />

                        <!-- Reasoning ring targets. They deliberately remain smaller than member targets. -->
                        <Button Style="{StaticResource ReasoningHotspotStyle}"
                                Canvas.Left="381" Canvas.Top="345"
                                Width="30" Height="30"
                                Tag="owner"
                                Click="Reasoning_Click"
                                ToolTip="Model & Reasoning — المالك"
                                automation:AutomationProperties.Name="استدلال المالك" />
                        <Button Style="{StaticResource ReasoningHotspotStyle}"
                                Canvas.Left="512" Canvas.Top="345"
                                Width="30" Height="30"
                                Tag="strategy"
                                Click="Reasoning_Click"
                                ToolTip="Model & Reasoning — الاستراتيجية"
                                automation:AutomationProperties.Name="استدلال الاستراتيجية" />
                        <Button Style="{StaticResource ReasoningHotspotStyle}"
                                Canvas.Left="643" Canvas.Top="345"
                                Width="30" Height="30"
                                Tag="research"
                                Click="Reasoning_Click"
                                ToolTip="Model & Reasoning — البحث"
                                automation:AutomationProperties.Name="استدلال البحث" />
                        <Button Style="{StaticResource ReasoningHotspotStyle}"
                                Canvas.Left="772" Canvas.Top="345"
                                Width="30" Height="30"
                                Tag="verification"
                                Click="Reasoning_Click"
                                ToolTip="Model & Reasoning — التحقق"
                                automation:AutomationProperties.Name="استدلال التحقق" />
                        <Button Style="{StaticResource ReasoningHotspotStyle}"
                                Canvas.Left="901" Canvas.Top="345"
                                Width="30" Height="30"
                                Tag="execution"
                                Click="Reasoning_Click"
                                ToolTip="Model & Reasoning — التنفيذ"
                                automation:AutomationProperties.Name="استدلال التنفيذ" />
                        <Button Style="{StaticResource ReasoningHotspotStyle}"
                                Canvas.Left="1030" Canvas.Top="345"
                                Width="30" Height="30"
                                Tag="creative"
                                Click="Reasoning_Click"
                                ToolTip="Model & Reasoning — الإبداع"
                                automation:AutomationProperties.Name="استدلال الإبداع" />
                        <Button Style="{StaticResource ReasoningHotspotStyle}"
                                Canvas.Left="1160" Canvas.Top="345"
                                Width="30" Height="30"
                                Tag="data"
                                Click="Reasoning_Click"
                                ToolTip="Model & Reasoning — البيانات"
                                automation:AutomationProperties.Name="استدلال البيانات" />
                        <Button Style="{StaticResource ReasoningHotspotStyle}"
                                Canvas.Left="1289" Canvas.Top="345"
                                Width="30" Height="30"
                                Tag="learning"
                                Click="Reasoning_Click"
                                ToolTip="Model & Reasoning — التعلم"
                                automation:AutomationProperties.Name="استدلال التعلم" />

                        <!-- Active Work -->
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="246" Canvas.Top="484"
                                Width="401" Height="215"
                                Tag="smart-secretary"
                                Click="Project_Click"
                                ToolTip="فتح المشروع الأول"
                                automation:AutomationProperties.Name="فتح مشروع Smart Secretary V2" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="654" Canvas.Top="484"
                                Width="396" Height="215"
                                Tag="privacy"
                                Click="Project_Click"
                                ToolTip="فتح المشروع الثاني"
                                automation:AutomationProperties.Name="فتح مشروع Privacy" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="1057" Canvas.Top="484"
                                Width="395" Height="215"
                                Tag="erasure"
                                Click="Project_Click"
                                ToolTip="فتح المشروع الثالث"
                                automation:AutomationProperties.Name="فتح مشروع Erasure Contract" />

                        <!-- Owner summary row -->
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="246" Canvas.Top="707"
                                Width="255" Height="194"
                                Tag="since-away"
                                Click="Region_Click"
                                ToolTip="منذ آخر زيارة"
                                automation:AutomationProperties.Name="منذ آخر زيارة" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="507" Canvas.Top="707"
                                Width="502" Height="194"
                                Tag="needs-decision"
                                Click="Region_Click"
                                ToolTip="يحتاج قرارك"
                                automation:AutomationProperties.Name="يحتاج قرارك" />
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="1014" Canvas.Top="707"
                                Width="439" Height="194"
                                Tag="recent-results"
                                Click="Region_Click"
                                ToolTip="النتائج الأخيرة"
                                automation:AutomationProperties.Name="النتائج الأخيرة" />

                        <!-- Persistent chrome -->
                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="9" Canvas.Top="912"
                                Width="1518" Height="100"
                                Tag="tool-dock"
                                Click="Region_Click"
                                ToolTip="Tool Dock"
                                automation:AutomationProperties.Name="Tool Dock" />

                        <Button Style="{StaticResource HotspotButtonStyle}"
                                Canvas.Left="1462" Canvas.Top="61"
                                Width="69" Height="850"
                                Tag="global-nav"
                                Click="Region_Click"
                                ToolTip="التنقل العام"
                                automation:AutomationProperties.Name="التنقل العام" />

                        <!-- Interaction emphasis: one bounded activation ring, event-driven only. -->
                        <Ellipse x:Name="RoleActivationRing"
                                 Width="118"
                                 Height="110"
                                 Visibility="Collapsed"
                                 Stroke="#B82F6BFF"
                                 StrokeThickness="3"
                                 Fill="Transparent"
                                 IsHitTestVisible="False"
                                 Opacity="0" />
                    </Canvas>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- Truthful non-authoritative interaction drawer layered over the canonical visual shell. -->
        <Border x:Name="ContextDrawer"
                Width="430"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="#FCFFFFFF"
                BorderBrush="{StaticResource ReferenceBorder}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed"
                Opacity="0"
                Panel.ZIndex="50"
                automation:AutomationProperties.Name="لوحة السياق">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerTransform" X="430" />
            </Border.RenderTransform>
            <Grid Margin="22,20,22,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="DrawerEyebrow"
                                   Text="ROLE CONTEXT"
                                   FlowDirection="LeftToRight"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ReferenceViolet}"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="DrawerTitle"
                                   Text="السياق"
                                   Margin="0,5,0,0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ReferenceInk}" />
                        <TextBlock x:Name="DrawerSubtitle"
                                   Text=""
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource ReferenceMuted}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="CloseDrawerButton"
                            Width="36"
                            Height="36"
                            Margin="14,0,0,0"
                            Content="×"
                            FontSize="22"
                            Background="#F6F8FC"
                            BorderBrush="{StaticResource ReferenceBorder}"
                            BorderThickness="1"
                            Foreground="{StaticResource ReferenceInk}"
                            Cursor="Hand"
                            Click="CloseDrawer_Click"
                            automation:AutomationProperties.Name="إغلاق لوحة السياق" />
                </Grid>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DrawerLabelStyle}" Text="لماذا يظهر / لماذا فُعّل" />
                        <TextBlock x:Name="DrawerWhy" Style="{StaticResource DrawerValueStyle}" />

                        <TextBlock Style="{StaticResource DrawerLabelStyle}" Text="المهمة الحالية" />
                        <TextBlock x:Name="DrawerTask" Style="{StaticResource DrawerValueStyle}" />

                        <TextBlock Style="{StaticResource DrawerLabelStyle}" Text="الحالة" />
                        <TextBlock x:Name="DrawerState" Style="{StaticResource DrawerValueStyle}" />

                        <TextBlock Style="{StaticResource DrawerLabelStyle}" Text="النتائج / السياق" />
                        <TextBlock x:Name="DrawerFindings" Style="{StaticResource DrawerValueStyle}" />

                        <TextBlock Style="{StaticResource DrawerLabelStyle}" Text="أقوى اعتراض" />
                        <TextBlock x:Name="DrawerDissent" Style="{StaticResource DrawerValueStyle}" />

                        <TextBlock Style="{StaticResource DrawerLabelStyle}" Text="الأدلة" />
                        <TextBlock x:Name="DrawerEvidence" Style="{StaticResource DrawerValueStyle}" />

                        <TextBlock Style="{StaticResource DrawerLabelStyle}" Text="النموذج / الاستدلال" />
                        <TextBlock x:Name="DrawerReasoning" Style="{StaticResource DrawerValueStyle}" />

                        <Border Height="1"
                                Background="{StaticResource ReferenceBorder}"
                                Margin="0,2,0,14" />

                        <Button Style="{StaticResource DrawerActionStyle}"
                                Content="اسأل عن نتيجة هذا العنصر"
                                Click="AskThis_Click" />
                        <Button Style="{StaticResource DrawerActionStyle}"
                                Content="فتح الأدلة"
                                Click="OpenEvidence_Click" />
                        <Button Style="{StaticResource DrawerActionStyle}"
                                Content="Model &amp; Reasoning Inspector"
                                Click="ReasoningInspector_Click" />
                        <Button Style="{StaticResource DrawerActionStyle}"
                                Content="مساهمات العنصر في المشروع"
                                Click="ContributionHistory_Click" />

                        <Border Margin="0,10,0,0"
                                Padding="12"
                                Background="#F5F7FB"
                                BorderBrush="{StaticResource ReferenceBorder}"
                                BorderThickness="1">
                            <TextBlock Text="هذه الطبقة تفاعلية حقيقية فوق المرجع البصري المعتمد. لا تمنح صلاحية تنفيذ حي ولا تختلق حالة تشغيل غير متوفرة."
                                       FontSize="11"
                                       Foreground="{StaticResource ReferenceMuted}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="PrototypeNotice"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="18"
                Padding="12,8"
                Background="#E914213D"
                CornerRadius="8"
                Visibility="Collapsed"
                Panel.ZIndex="60">
            <TextBlock x:Name="PrototypeNoticeText"
                       Foreground="White"
                       FontSize="12"
                       TextWrapping="Wrap"
                       MaxWidth="520" />
        </Border>
    </Grid>
</Window>
