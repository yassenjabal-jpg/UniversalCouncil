<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>UniversalCouncil.CommandCenter.Stage4Validation</AssemblyName>
    <RootNamespace>UniversalCouncil.CommandCenter.Stage4Validation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UniversalCouncil.CommandCenter.Core\UniversalCouncil.CommandCenter.Core.csproj" />
    <ProjectReference Include="..\UniversalCouncil.CommandCenter.Application\UniversalCouncil.CommandCenter.Application.csproj" />
    <ProjectReference Include="..\UniversalCouncil.CommandCenter.Infrastructure\UniversalCouncil.CommandCenter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\state\command-center\execution-fabric.json"
             Link="state\execution-fabric.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
